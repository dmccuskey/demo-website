# The shape of .env. Copy it to .env, in the repository's root, and set each value there.
# .env is never committed.

# The domain that every hostname is under: the website is demo.<domain>, and a demo is
# <name>.<domain>. On a Mac, `localhost` works without any DNS: a browser opens
# http://<name>.localhost:8080
DEMO_DOMAIN=example.com

# The token a demo's live server presents to write to its data service. Any value, kept secret:
# for example the output of `openssl rand -hex 32`
DATA_SERVICE_WRITE_TOKEN=

# Optional: the port on this machine (127.0.0.1 only) that Caddy listens on. Default 8080
#CADDY_PORT=8080

# The tunnel, on the host only: the profile that starts cloudflared, and the tunnel's token from
# the Cloudflare account. Leave both out on a Mac without a tunnel
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=
